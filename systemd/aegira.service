[Unit]
Description=Aegira Automated Recovery Engine
After=network.target

[Service]
Type=simple
User=pikachu
WorkingDirectory=/home/pikachu/aegira
EnvironmentFile=/home/pikachu/aegira/config/aegira.env
ExecStart=/usr/local/bin/aegira
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
